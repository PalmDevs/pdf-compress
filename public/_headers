# Cloudflare Pages response headers. Vite copies this file into dist/.

# Hashed build output (JS, CSS, wasm) never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Offline support files must always be revalidated so updates are noticed.
/sw.js
  Cache-Control: no-cache
/precache.json
  Cache-Control: no-cache
